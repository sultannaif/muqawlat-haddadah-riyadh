const wa='https://wa.me/966537857944?text='+encodeURIComponent('السلام عليكم، أحتاج أعمال حدادة في الرياض. المطلوب: ... الحي: ... المقاسات التقريبية: ...');
---
<Layout title="حداد بالرياض | سواتر وأعمال حديد | مقاول الرياض" description="تنفيذ سواتر وأعمال حدادة وهياكل حديد بالرياض حسب المقاس والتصميم. شاهد نماذج الأعمال وتواصل مباشرة عبر واتساب لطلب تسعيرة."><section class="detail-hero"><div><div class="breadcrumb"><a href="/">الرئيسية</a> / أعمال الحدادة</div><p class="eyebrow">حدادة الرياض</p><h1>تفاصيل حديد،<br/>تكمّل مكانك.</h1><p class="lead">أعمال حديد حسب المقاس، من السواتر والتفاصيل المزخرفة إلى هياكل المظلات والبرجولات. نراجع المطلوب ونتفق على التصميم والخامة قبل التنفيذ.</p><a class="button primary" href={wa} target="_blank" rel="noopener">اطلب تسعيرة حدادة ↗</a></div><img src="/images/work-14.webp" width="1100" height="900" alt="ساتر حديد أسود بنقوش هندسية مثبت فوق سور" fetchpriority="high"/></section><section class="section detail-content"><h2>تفصيل يناسب المقاس والاستخدام</h2><h3>سواتر حديد</h3><p>نناقش درجة الخصوصية المطلوبة والارتفاع والتصميم ومكان التركيب. تختلف خيارات النقوش والشرائح بحسب الاستخدام والمظهر الذي تفضله.</p><h3>هياكل مظلات وبرجولات</h3><p>تحديد أبعاد الهيكل والأعمدة والتثبيت يبدأ من معاينة طبيعة المكان ومتطلبات التغطية. نوضح تفاصيل العمل المتفق عليه قبل التصنيع.</p><h3>تفاصيل حديد حسب الطلب</h3><p>أرسل صورة الفكرة أو رسم المقاسات. نراجع إمكانية تنفيذها، ونناقش شكل القطاعات واللون والتشطيب المناسب للاستخدام الخارجي.</p><h2>نماذج التفاصيل والتشطيبات</h2><div class="detail-gallery">{[{i:14,a:'حديد مزخرف فوق سور'},{i:17,a:'ساتر حديد بزخارف هندسية'},{i:21,a:'ساتر شرائح معدنية داكنة'},{i:24,a:'هيكل برجولة حديد'},{i:31,a:'تفاصيل سقف حديد مزخرف'},{i:35,a:'برجولة بخطوط حديد مستقيمة'}].map(p=><a href={'/images/work-'+p.i+'.webp'} target="_blank" rel="noopener"><img src={'/images/work-'+p.i+'.webp'} alt={p.a} width="600" height="800" loading="lazy"/></a>)}</div><h2>ما الذي يؤثر على تسعيرة الحدادة؟</h2><p>المقاسات، وسماكة القطاعات ونوعها، وتعقيد التصميم، والتشطيب، وطريقة التركيب. لذلك نتفق على مواصفات واضحة قبل تحديد السعر النهائي.</p><h2>ابدأ بصورة ومقاس تقريبي</h2><p>أرسل نوع العمل والحي في الرياض وصورة للموقع. إذا كان الطلب مرتبطاً بتغطية موقف أو جلسة، يمكنك أيضاً مشاهدة <a class="underlink" href="/shades/">المظلات والبرجولات</a>.</p><a class="button primary" href={wa} target="_blank" rel="noopener">ناقش أعمال الحدادة على واتساب ↗</a></section></Layout>

