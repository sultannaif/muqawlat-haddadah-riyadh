import Layout from '../layouts/Layout.astro';
const wa='https://wa.me/966537857944?text='+encodeURIComponent('السلام عليكم، أحتاج تسعيرة. الخدمة: ... الحي في الرياض: ... المقاسات التقريبية: ...');
const projects=[{id:7,title:'مظلات مواقف السيارات',tag:'المظلات'},{id:27,title:'جلسات خارجية مظللة',tag:'البرجولات'},{id:14,title:'تفاصيل حديد للسواتر',tag:'الحدادة'},{id:33,title:'برجولات للمساحات الخارجية',tag:'البرجولات'}];
---
<Layout title="مقاول الرياض | مظلات وسواتر وأعمال حدادة" description="مقاول بالرياض لتنفيذ مظلات السيارات والسواتر والبرجولات وأعمال الحدادة حسب المقاس. شاهد نماذج الأعمال وتواصل مباشرة عبر واتساب لطلب تسعيرة.">
<section class="hero"><div class="hero-copy"><p class="eyebrow">حدادة ومظلات · الرياض</p><h1>ظلّ يناسب مكانك.<br/><em>وحدادة على مقاسك.</em></h1><p class="lead">مظلات للمواقف والأحواش، برجولات للجلسات، وأعمال حديد حسب احتياجك. من أول فكرة إلى تفاصيل التنفيذ، تواصلك معي مباشرة.</p><div class="actions"><a class="button primary" href={wa} target="_blank" rel="noopener">اطلب تسعيرتك على واتساب <span>↗</span></a><a class="text-link" href="#projects">شاهد الأعمال <span>↓</span></a></div><div class="hero-notes"><span>تنفيذ حسب المقاس</span><span>خيارات تناسب المكان</span><span>تواصل مع المقاول مباشرة</span></div></div><div class="hero-photo"><img src="/images/work-27.webp" alt="برجولة حديد بنقوش هندسية فوق جلسة خارجية" width="1000" height="1200" fetchpriority="high"/><div class="photo-caption"><span>مساحة تستحق أن تستفيد منها</span><span>حدادة · مظلات · برجولات</span></div></div></section>
<div class="service-strip"><span>للمنازل والفلل</span><span>لمواقف السيارات</span><span>للأحواش والجلسات</span><span>في الرياض</span></div>
<section class="section" id="services"><div class="section-heading"><div><p class="eyebrow">الخدمات</p><h2>كل مساحة، ولها شغلها.</h2></div><p>نبدأ بما تحتاجه، ونحدد المقاس والشكل والخامة المناسبة قبل التنفيذ.</p></div><div class="service-grid"><a class="service-card" href="/shades/"><img src="/images/work-7.webp" alt="مظلات متصلة لتغطية مواقف السيارات" width="900" height="700" loading="lazy"/><div><span class="number">01 / المظلات</span><h3>مظلات وبرجولات <span>↖</span></h3><p>تغطية للمواقف والأحواش والجلسات، بتصاميم تناسب المساحة.</p><span class="underlink">تفاصيل خدمة المظلات</span></div></a><a class="service-card" href="/metalwork/"><img src="/images/work-14.webp" alt="ساتر حديد مزخرف بنقوش هندسية" width="900" height="700" loading="lazy"/><div><span class="number">02 / الحدادة</span><h3>أعمال حديد وسواتر <span>↖</span></h3><p>تفصيل هياكل وسواتر حديد، مع الاتفاق على التصميم والتشطيب.</p><span class="underlink">تفاصيل خدمة الحدادة</span></div></a></div></section>
<section class="projects-section section" id="projects"><div class="section-heading"><div><p class="eyebrow">معرض الأعمال</p><h2>خذ فكرة. واختر ما يناسبك.</h2></div><a class="text-link" href={wa} target="_blank" rel="noopener">أرسل صورة التصميم الذي يعجبك ↗</a></div><div class="projects-grid">{projects.map(p=><figure><a href={'/images/work-'+p.id+'.webp'} target="_blank" rel="noopener" aria-label={'عرض صورة '+p.title}><img src={'/images/work-'+p.id+'.webp'} alt={p.title} width="800" height="1000" loading="lazy"/></a><figcaption><small>{p.tag}</small><h3>{p.title}</h3></figcaption></figure>)}</div></section>
<section class="section process"><div><p class="eyebrow">من الفكرة إلى التنفيذ</p><h2>خلّ البداية<br/>رسالة واتساب.</h2><p>لا تحتاج مخططاً جاهزاً. صورة للمكان والمقاسات التقريبية تساعدنا نبدأ.</p></div><ol><li><span>01</span><div><h3>أرسل تفاصيل المكان</h3><p>نوع الخدمة، الحي، وصورة للموقع أو التصميم الذي تفضله.</p></div></li><li><span>02</span><div><h3>نناقش الخيارات والتسعيرة</h3><p>نحدد الخامة والمقاسات والتثبيت، ومدى الحاجة إلى معاينة.</p></div></li><li><span>03</span><div><h3>نتفق على التنفيذ</h3><p>نوضح نطاق العمل والسعر والموعد قبل البدء.</p></div></li></ol></section>
<section class="section faq"><p class="eyebrow">قبل ما تتواصل</p><h2>أسئلة تهمك</h2><details><summary>كم تكلفة المظلات أو أعمال الحدادة؟</summary><p>تختلف حسب المساحة والخامة والتصميم وطريقة التثبيت. أرسل المقاسات التقريبية وصورة للمكان على واتساب لنناقش المطلوب ونحدد التسعيرة.</p></details><details><summary>هل أقدر أرسل تصميم وأطلب مثله؟</summary><p>نعم، أرسل صورة التصميم مع أبعاد المكان. نناقش إمكانية تنفيذه والتعديلات المطلوبة بحسب الموقع والخامة.</p></details><details><summary>هل تخدمون موقعي في الرياض؟</summary><p>الخدمة في الرياض. أرسل اسم الحي والموقع على واتساب لتأكيد إمكانية التنفيذ وترتيب المعاينة عند الحاجة.</p></details></section>
<section class="contact-band"><p class="eyebrow">عندك مساحة في بالك؟</p><h2>أرسل صورتها، ونبدأ منها.</h2><p>اذكر الخدمة والحي والمقاسات التقريبية، وسنتواصل معك لمناقشة التفاصيل.</p><a class="button primary" href={wa} target="_blank" rel="noopener">تحدث معي على واتساب ↗</a><a class="phone" href="tel:+966537857944" dir="ltr">053 785 7944</a></section>
</Layout>

